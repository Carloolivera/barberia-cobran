# Database (Neon PostgreSQL)
# Get from: console.neon.tech → your project → Connection details
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb"

# Auth
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-random-secret"

# Admin password (plaintext, stored in env — never commit the real value)
ADMIN_PASSWORD="replace-with-strong-password"

# App URL (used by next-auth)
NEXTAUTH_URL="http://localhost:3000"
